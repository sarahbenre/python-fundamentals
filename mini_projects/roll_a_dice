    "# Project - roll a dice\n",
    "    # Roll the dice? (y/n)\n",
    "    # If Y\n",
    "        # 2 random numbers between 1 and 6\n",
    "    # If N\n",
    "        # \"Thanks for playing!\" and this is the end\n",
    "    # If no N and no Y\n",
    "        # error message\n",
    "    # we want the game to terminate only when \"N\" is input = LOOP!\n",
    "\n",
    "# First we have to import the random module\n",
    "import random\n",
    "\n",
    "# Then we create the loop\n",
    "while True:\n",
    "# Here is what's in the loop : \n",
    "    choice = input(\"Roll the dice? (y/n): \").lower()\n",
    "        # \"lower\" here is used to make it so the code works even when the user types a capital \"Y\"\n",
    "    if choice == \"y\":\n",
    "        nb1 = random.randint(1,6)\n",
    "        nb2 = random.randint(1,6)\n",
    "        print(f\"{nb1}, {nb2}\")\n",
    "        # f stands for format(ting), it is used evaluate the variable = looks up the variable's name n its memory\n",
    "        # we put or two variables in between placeholders ({}) so that f evaluates the variable inside those and \n",
    "        # so that the print function doesnt literally print \"nb1\" and \"nb2\" \n",
    "    elif choice == \"n\":\n",
    "        print (\"Thanks for playing!\")\n",
    "        break\n",
    "    else:\n",
    "        print(\"Error\")\n",
    "\n",
    "    # Errors in the code (before correction):\n",
    "        # no \":\" after while and ifs\n",
    "        # indent before print when it was uncessary"
   ]
  }
